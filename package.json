{
  "name": "effect-ui-extra",
  "version": "0.5.1",
  "description": "Unified companion toolkit for @effect/ui: a11y (APG/RTL/names/checkMarkup), page (zero-FOUC prefs/CSP/tabbable/Form validationMode/history stage+marks/SSR), widgets (Command/Tree/AreaPicker/ScrollPicker/DateTimePicker/Carousel/ImageCropper/Timeline/Waterfall), direct-manipulation/2D move+resize/textEditor/VirtualGrid/CLDR date, OKLCH/WCAG/deltaEOK theme, spring/sheet/safePolygon motion, and 82-item wired shadcn-parity registry + namespaced @org/item CLI + MCP server",
  "license": "MIT",
  "type": "module",
  "bin": {
    "effect-ui": "./src/cli/index.ts"
  },
  "packageManager": "bun@1.4.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxFabian25/effect-ui-extra.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./a11y": {
      "types": "./src/a11y/index.ts",
      "bun": "./src/a11y/index.ts",
      "default": "./dist/a11y/index.js"
    },
    "./page": {
      "types": "./src/page/index.ts",
      "bun": "./src/page/index.ts",
      "default": "./dist/page/index.js"
    },
    "./widgets": {
      "types": "./src/widgets/index.ts",
      "bun": "./src/widgets/index.ts",
      "default": "./dist/widgets/index.js"
    },
    "./direct": {
      "types": "./src/direct/index.ts",
      "bun": "./src/direct/index.ts",
      "default": "./dist/direct/index.js"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "bun": "./src/theme/index.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/effect-ui.css": "./styles/effect-ui.css",
    "./motion": {
      "types": "./src/motion/index.ts",
      "bun": "./src/motion/index.ts",
      "default": "./dist/motion/index.js"
    },
    "./registry": {
      "types": "./src/registry/index.ts",
      "bun": "./src/registry/index.ts",
      "default": "./dist/registry/index.js"
    }
  },
  "publishConfig": {
    "bin": {
      "effect-ui": "./dist/cli/index.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./a11y": {
        "types": "./dist/a11y/index.d.ts",
        "import": "./dist/a11y/index.js"
      },
      "./page": {
        "types": "./dist/page/index.d.ts",
        "import": "./dist/page/index.js"
      },
      "./widgets": {
        "types": "./dist/widgets/index.d.ts",
        "import": "./dist/widgets/index.js"
      },
      "./direct": {
        "types": "./dist/direct/index.d.ts",
        "import": "./dist/direct/index.js"
      },
      "./theme": {
        "types": "./dist/theme/index.d.ts",
        "import": "./dist/theme/index.js"
      },
      "./theme/effect-ui.css": "./styles/effect-ui.css",
      "./motion": {
        "types": "./dist/motion/index.d.ts",
        "import": "./dist/motion/index.js"
      },
      "./registry": {
        "types": "./dist/registry/index.d.ts",
        "import": "./dist/registry/index.js"
      }
    }
  },
  "files": [
    "dist",
    "styles",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "gen:docs": "bun scripts/gen-docs.ts",
    "check:docs": "bun scripts/gen-docs.ts --check",
    "check:consumer": "bun scripts/check-consumer.ts",
    "check:size": "bun scripts/check-size.ts",
    "verify": "bun run check && bun run build && bun test && bun run check:docs && bun run check:consumer && bun run check:size"
  },
  "peerDependencies": {
    "@effect/ui": "*",
    "@effect/ui-kit": "*",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@22128c6",
    "@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@22128c6",
    "@types/bun": "1.4.5",
    "effect": "4.1.6",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3"
  }
}
